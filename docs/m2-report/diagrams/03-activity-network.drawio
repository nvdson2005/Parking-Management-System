<mxfile host="drawio"><diagram name="Page-1"><mxGraphModel adaptiveColors="auto" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="A-01" value="&lt;b&gt;A-01&lt;/b&gt;&lt;br&gt;Hoàn thiện SRS v1.0 từ bản nháp&lt;br&gt;&lt;i&gt;E = 4,33 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-22" value="&lt;b&gt;A-22&lt;/b&gt;&lt;br&gt;Hoàn thiện P18 v1.0 và chốt hướng xử lý các khác biệt KB-01 đến KB-19&lt;br&gt;&lt;i&gt;E = 4,33 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-43" value="&lt;b&gt;A-43&lt;/b&gt;&lt;br&gt;Rà soát bộ mô phỏng theo PD-P04 và lập danh mục kịch bản SC-01 đến SC-07&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-96" value="&lt;b&gt;A-96&lt;/b&gt;&lt;br&gt;Chạy bộ kiểm thử tự động lần đầu và ghi Quality Evidence&lt;br&gt;&lt;i&gt;E = 2,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="0" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-09" value="&lt;b&gt;A-09&lt;/b&gt; [CP-01]&lt;br&gt;Review SRS&lt;br&gt;&lt;i&gt;E = 3 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="290" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-13" value="&lt;b&gt;A-13&lt;/b&gt;&lt;br&gt;Lập tài liệu thiết kế giao diện từ màn hình đã có&lt;br&gt;&lt;i&gt;E = 4,75 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-24" value="&lt;b&gt;A-24&lt;/b&gt;&lt;br&gt;Hoàn thiện thiết kế CSDL v1.0&lt;br&gt;&lt;i&gt;E = 2,25 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-47" value="&lt;b&gt;A-47&lt;/b&gt;&lt;br&gt;Lập tài liệu dữ liệu mô phỏng bãi thí điểm&lt;br&gt;&lt;i&gt;E = 1,5 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-61" value="&lt;b&gt;A-61&lt;/b&gt;&lt;br&gt;Kiểm thử mô-đun quản lý thông tin bãi&lt;br&gt;&lt;i&gt;E = 1,5 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="480" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-77" value="&lt;b&gt;A-77&lt;/b&gt;&lt;br&gt;Rà soát và kiểm thử mô-đun báo cáo&lt;br&gt;&lt;i&gt;E = 2,58 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="600" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-80" value="&lt;b&gt;A-80&lt;/b&gt;&lt;br&gt;Hoàn thiện kế hoạch kiểm thử v1.0&lt;br&gt;&lt;i&gt;E = 2 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="720" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-23" value="&lt;b&gt;A-23&lt;/b&gt; [CP-02]&lt;br&gt;Review kiến trúc và API&lt;br&gt;&lt;i&gt;E = 2 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="580" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-27" value="&lt;b&gt;A-27&lt;/b&gt; [CP-03]&lt;br&gt;Review thiết kế CSDL&lt;br&gt;&lt;i&gt;E = 1,5 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-82" value="&lt;b&gt;A-82&lt;/b&gt;&lt;br&gt;Viết kịch bản nghiệm thu chính AT-01 đến AT-07&lt;br&gt;&lt;i&gt;E = 5,5 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-83" value="&lt;b&gt;A-83&lt;/b&gt;&lt;br&gt;Viết kịch bản nghiệm thu ngoại lệ và kịch bản 100 lượt&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-28" value="&lt;b&gt;A-28&lt;/b&gt;&lt;br&gt;Sửa xác thực và nhật ký truy cập theo review&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-79" value="&lt;b&gt;A-79&lt;/b&gt;&lt;br&gt;Xây dựng bộ kiểm thử hợp đồng API vào/ra&lt;br&gt;&lt;i&gt;E = 2,08 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-70" value="&lt;b&gt;A-70&lt;/b&gt;&lt;br&gt;Rà soát và sửa mô-đun đặt chỗ&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-65" value="&lt;b&gt;A-65&lt;/b&gt;&lt;br&gt;Bổ sung API cho nhật ký truy cập, lượt gửi và lịch sử thanh toán&lt;br&gt;&lt;i&gt;E = 4,33 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-44" value="&lt;b&gt;A-44&lt;/b&gt;&lt;br&gt;Sửa bộ mô phỏng theo review&lt;br&gt;&lt;i&gt;E = 5,33 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="480" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-63" value="&lt;b&gt;A-63&lt;/b&gt;&lt;br&gt;Sửa luồng xe vào/ra theo review&lt;br&gt;&lt;i&gt;E = 6,33 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="600" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-85" value="&lt;b&gt;A-85&lt;/b&gt; [CP-06]&lt;br&gt;Review bộ test nghiệm thu và gửi khách hàng xác nhận&lt;br&gt;&lt;i&gt;E = 2,5 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="870" y="720" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-31" value="&lt;b&gt;A-31&lt;/b&gt;&lt;br&gt;Kiểm thử mô-đun xác thực và phân quyền&lt;br&gt;&lt;i&gt;E = 2 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1160" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-72" value="&lt;b&gt;A-72&lt;/b&gt;&lt;br&gt;Kiểm thử mô-đun đặt chỗ&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteS