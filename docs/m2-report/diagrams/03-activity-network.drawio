<mxfile host="drawio"><diagram name="Page-1"><mxGraphModel adaptiveColors="auto" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="A-01" value="&lt;b&gt;A-01&lt;/b&gt;&lt;br&gt;Viết SRS v1.0 phạm vi Must&lt;br&gt;&lt;i&gt;E = 12,33 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-20" value="&lt;b&gt;A-20&lt;/b&gt;&lt;br&gt;Chọn công nghệ và thiết kế kiến trúc tổng thể&lt;br&gt;&lt;i&gt;E = 5,42 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-24" value="&lt;b&gt;A-24&lt;/b&gt;&lt;br&gt;Thiết kế ERD và từ điển dữ liệu&lt;br&gt;&lt;i&gt;E = 5,83 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-40" value="&lt;b&gt;A-40&lt;/b&gt;&lt;br&gt;Xây dựng cấu hình, bộ sinh dữ liệu giả và bộ sinh sự kiện&lt;br&gt;&lt;i&gt;E = 4,75 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="0" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-09" value="&lt;b&gt;A-09&lt;/b&gt; [CP-01]&lt;br&gt;Review SRS&lt;br&gt;&lt;i&gt;E = 3 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="290" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-13" value="&lt;b&gt;A-13&lt;/b&gt;&lt;br&gt;Thiết kế giao diện luồng cốt lõi&lt;br&gt;&lt;i&gt;E = 4,75 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-80" value="&lt;b&gt;A-80&lt;/b&gt;&lt;br&gt;Viết kế hoạch kiểm thử&lt;br&gt;&lt;i&gt;E = 3,75 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-21" value="&lt;b&gt;A-21&lt;/b&gt;&lt;br&gt;Thiết kế quy ước API và hợp đồng sự kiện vào/ra&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-26" value="&lt;b&gt;A-26&lt;/b&gt;&lt;br&gt;Viết và kiểm thử script lược đồ, dữ liệu mẫu, script lưu giữ&lt;br&gt;&lt;i&gt;E = 5,42 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="480" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-82" value="&lt;b&gt;A-82&lt;/b&gt;&lt;br&gt;Viết kịch bản nghiệm thu chính AT-01 đến AT-04&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-83" value="&lt;b&gt;A-83&lt;/b&gt;&lt;br&gt;Viết kịch bản nghiệm thu ngoại lệ và kịch bản 100 lượt&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-48" value="&lt;b&gt;A-48&lt;/b&gt;&lt;br&gt;Xây dựng mô-đun hiển thị tình trạng chỗ đỗ&lt;br&gt;&lt;i&gt;E = 7 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-60" value="&lt;b&gt;A-60&lt;/b&gt;&lt;br&gt;Xây dựng mô-đun quản lý thông tin bãi&lt;br&gt;&lt;i&gt;E = 7,92 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-22" value="&lt;b&gt;A-22&lt;/b&gt;&lt;br&gt;Đặc tả API mô-đun cốt lõi&lt;br&gt;&lt;i&gt;E = 4,83 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="480" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-42" value="&lt;b&gt;A-42&lt;/b&gt;&lt;br&gt;Xây dựng bộ gửi sự kiện và nhật ký chạy&lt;br&gt;&lt;i&gt;E = 3,75 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="600" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-79" value="&lt;b&gt;A-79&lt;/b&gt;&lt;br&gt;Xây dựng bộ kiểm thử hợp đồng API vào/ra&lt;br&gt;&lt;i&gt;E = 2,08 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="720" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-28" value="&lt;b&gt;A-28&lt;/b&gt;&lt;br&gt;Xây dựng đăng ký, đăng nhập, phiên và RBAC&lt;br&gt;&lt;i&gt;E = 6 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="840" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-27" value="&lt;b&gt;A-27&lt;/b&gt; [CP-03]&lt;br&gt;Review thiết kế CSDL&lt;br&gt;&lt;i&gt;E = 1,5 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="580" y="960" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-78" value="&lt;b&gt;A-78&lt;/b&gt;&lt;br&gt;Thử nghiệm xử lý đồng thời cập nhật chỗ trống&lt;br&gt;&lt;i&gt;E = 2,08 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="1080" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-85" value="&lt;b&gt;A-85&lt;/b&gt; [CP-06]&lt;br&gt;Review bộ test nghiệm thu và gửi khách hàng xác nhận&lt;br&gt;&lt;i&gt;E = 2,5 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="870" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-23" value="&lt;b&gt;A-23&lt;/b&gt; [CP-02]&lt;br&gt;Review kiến trúc và API&lt;br&gt;&lt;i&gt;E = 2 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-47" value="&lt;b&gt;A-47&lt;/b&gt;&lt;br&gt;Tạo dữ liệu mô phỏng bãi thí điểm&lt;br&gt;&lt;i&gt;E = 2,25 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-43" value="&lt;b&gt;A-43&lt;/b&gt;&lt;br&gt;Xây dựng kịch bản mô phỏng và README&lt;br&gt;&lt;i&gt;E = 4,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-61" value="&lt;b&gt;A-61&lt;/b&gt;&lt;br&gt;Kiểm thử mô-đun quản lý thông tin bãi&lt;br&gt;&lt;i&gt;E = 1,5 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="480" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-63" value="&lt;b&gt;A-63&lt;/b&gt;&lt;br&gt;Xây dựng API sự kiện vào/ra và cập nhật chỗ trống&lt;br&gt;&lt;i&gt;E = 7,92 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="600" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-30" value="&lt;b&gt;A-30&lt;/b&gt;&lt;br&gt;Xây dựng che biển số, nhật ký truy cập và màn hình tài khoản&lt;br&gt;&lt;i&gt;E = 4,92 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="870" y="720" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-45" value="&lt;b&gt;A-45&lt;/b&gt; [CP-04]&lt;br&gt;Kiểm thử và review bộ mô phỏng&lt;br&gt;&lt;i&gt;E = 2 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="1160" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-66" value="&lt;b&gt;A-66&lt;/b&gt;&lt;br&gt;Xây dựng màn hình ghi nhận xe vào/ra&lt;br&gt;&lt;i&gt;E = 4,92 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-65" value="&lt;b&gt;A-65&lt;/b&gt;&lt;br&gt;Xây dựng xử lý 5 ngoại lệ xe vào/ra&lt;br&gt;&lt;i&gt;E = 5,83 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1160" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-31" value="&lt;b&gt;A-31&lt;/b&gt;&lt;br&gt;Kiểm thử mô-đun xác thực và phân quyền&lt;br&gt;&lt;i&gt;E = 2 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1160" y="360" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-33" value="&lt;b&gt;A-33&lt;/b&gt;&lt;br&gt;Viết hướng dẫn cài đặt và chạy demo&lt;br&gt;&lt;i&gt;E = 2 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1450" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-67" value="&lt;b&gt;A-67&lt;/b&gt;&lt;br&gt;Tích hợp mô-đun xe ra/vào với bộ mô phỏng&lt;br&gt;&lt;i&gt;E = 2,75 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1450" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-95" value="&lt;b&gt;A-95&lt;/b&gt;&lt;br&gt;Chạy thử sớm AT-01, AT-02 và kịch bản 100 lượt&lt;br&gt;&lt;i&gt;E = 2,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1740" y="0" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-49" value="&lt;b&gt;A-49&lt;/b&gt;&lt;br&gt;Kiểm thử mô-đun hiển thị chỗ trống&lt;br&gt;&lt;i&gt;E = 2 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1740" y="120" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-68" value="&lt;b&gt;A-68&lt;/b&gt; [CP-05]&lt;br&gt;Kiểm thử mô-đun xe ra/vào&lt;br&gt;&lt;i&gt;E = 3,17 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="1740" y="240" width="190" height="84" as="geometry"/></mxCell><mxCell id="A-90" value="&lt;b&gt;A-90&lt;/b&gt;&lt;br&gt;Tổng hợp số liệu thực tế và so sánh với baseline&lt;br&gt;&lt;i&gt;E = 3,42 h&lt;/i&gt;" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fillColor=#FFFFFF;